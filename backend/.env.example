PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Usernames (comma separated) that can post announcements and delete any chat message.
# Register these accounts first, then list them here and restart the server.
ADMIN_USERNAMES=

# Optional
# NODE_ENV=production
# CORS_ORIGIN=https://your-frontend-site.example
# REMINDER_HOUR_UTC=16        # streak reminders are sent after this hour (UTC)
# GCE_DATA_DIR=/var/lib/gce   # keep users/scores/chat/notifications outside the project folder
